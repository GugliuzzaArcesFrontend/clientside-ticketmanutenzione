@inherits LayoutComponentBase

@inject UserSessionService UserSessionService
@inject ComponentsHandlingService ComponentsHandling
@inject IJSRuntime JS

@implements IDisposable

<CascadingValue Value="UserSessionService" IsFixed="false">
    
    <Header />
    <Sidebar isSidebarOpen="isSidebarOpen"/>
    @* <aside 
        class="sidebar px-3 pt-3 position-fixed top-0 start-0 h-100 bg-dark border-end @(isSidebarOpen ? "open" : "")"

    >
        <span>
        <button class="btn btn-outline-light me-3"
