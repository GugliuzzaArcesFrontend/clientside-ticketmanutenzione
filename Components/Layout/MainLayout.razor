<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    private bool isSidebarOpen=false;
    protected override async Task OnInitializedAsync()
    {
        ComponentsHandling.OnSetTheme += HandleThemeChanged;
        ComponentsHandling.OnToggleSidebar += ToggleSidebar;
        UserSessionService.OnChange += HandleUserSessionChanged;
        await UserSessionService.InitializeUserAsync();
    }
    private void HandleUserSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
        _ = InvokeAsync(StateHasChanged);
    }
    private void CloseSide()
    {
        if (isSidebarOpen)
        {
            isSidebarOpen = false;
            StateHasChanged();
        }
    }
    public void Dispose()
    {
        ComponentsHandling.OnSetTheme -= HandleThemeChanged;
        ComponentsHandling.OnToggleSidebar -= ToggleSidebar;
        UserSessionService.OnChange -= HandleUserSessionChanged;
    }

    // private void HandleThemeChange(ChangeEventArgs args)
    // {
    //     if (Enum.TryParse<ComponentsHandlingService.ThemeMode>(
    //         args.Value?.ToString(),
    //         out var theme))
    //     {
    //         ComponentsHandling.SetTheme(theme);
    //     }
    // }

    // private async Task HandleThemeChanged()
    // {
    //     await InvokeAsync(async () =>
    //     {
    //         await JS.InvokeVoidAsync(
    //             "themeManager.setTheme",
    //             ComponentsHandling.Theme.ToString()
    //         );
    //     });
    // }
    private void HandleThemeChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await JS.InvokeVoidAsync(
                "themeManager.setTheme",
                ComponentsHandling.SelectedTheme.ToString()
            );
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // await JS.InvokeVoidAsync(
            //     "themeManager.setTheme",
            //     ComponentsHandling.Theme.ToString()
            // );

            var savedTheme = await JS.InvokeAsync<string>(
                        "themeManager.initialize",
                        ComponentsHandling.SelectedTheme.ToString()
                    );

            if (Enum.TryParse<ComponentsHandlingService.Theme>(
                savedTheme,
                out var theme))
            {
                ComponentsHandling.SetTheme(theme);
            }
        }
    }
}