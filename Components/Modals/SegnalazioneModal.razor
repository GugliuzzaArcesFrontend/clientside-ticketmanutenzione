@inject AuthenticatedHttpService AuthedHttp
@inject AuthenticationStateProvider AuthenticationState

@if (segnalazione is not null && SegnalazioneAperta)
{
    <ModalBackdrop @onclick="Chiudi">
        <ModalPiece class="d-flex flex-column " @onclick:stopPropagation>
            <p>Id segnalazione: @segnalazione.Id</p>
            <p>Luogo: @segnalazione.Luogo</p>
            <p>Data Apertura: @segnalazione.DataSegnalazione</p>        
            <p>Descrizione segnalazione: @segnalazione.Descrizione</p>


            @* 
                creare un dto per servire la segnalazione in dettaglio (completa di azioni e allegati)
                modificare il modal per permettere archiviazione/eliminazione o chiusura con successo segnalazione
                creare qui in template i for di azioni e allegati corrispondenti 
                creare bottone aggiungi azione e aggiungi allegato
            *@
            <div class="ms-auto">
                <CustomButtonSm Classes="btn-danger" @onclick="Chiudi">Chiudi</CustomButtonSm>
            </div>
        </ModalPiece>
    </ModalBackdrop>
}

@code {
    [CascadingParameter]
    public UserSessionService? UserSession { get; set; } = default!;
    [Parameter]
    public int IdSegnalazione { get; set; }
    [Parameter]
    public bool SegnalazioneAperta { get; set; }

    private SegnalazioniOperatoreDto? segnalazione;
    
    [Parameter]
    public EventCallback OnChiudiDettagli { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IdSegnalazione!=0)
        {            
            try
            {
                // var authState = await AuthenticationState.GetAuthenticationStateAsync();
                // var user = authState.User;
                // var sessionId = user.FindFirst("sid")?.Value;
                // var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                var userId = UserSession?.UserId;
                if (string.IsNullOrWhiteSpace(userId))
                    throw new UnauthorizedAccessException("UserId non presente nei claims.");

                using var segnalazioneResponse = await AuthedHttp.SendAsync(
                    HttpMethod.Get,
                    $"utenze/{userId}/segnalazioni/{IdSegnalazione}"
                );
                segnalazioneResponse.EnsureSuccessStatusCode();
                segnalazione = await segnalazioneResponse.Content.ReadFromJsonAsync<SegnalazioniOperatoreDto>();
            }
            catch (UnauthorizedAccessException ex)
            {
                //Implementare auth.refresh/vedere inner exceptions di unauthorized per capirle meglio
            }
        }
        else
        {
            segnalazione = null;
        }
    }
    private async Task Chiudi()
    {
        if (OnChiudiDettagli.HasDelegate)
        {
            await OnChiudiDettagli.InvokeAsync();
        }
    }
}
