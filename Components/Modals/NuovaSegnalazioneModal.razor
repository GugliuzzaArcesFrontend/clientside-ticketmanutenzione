@inject AuthenticatedHttpService AuthedHttp
@inject AuthenticationStateProvider AuthProvider
@inject IHttpClientFactory HttpClientFactory

@if (Nuova)
{
    <div class="modal-backdrop" @onclick="Chiudi">
        <dialog @onclick:stopPropagation open >
            @if(!elaborazione)
            {
            <h3>NuovaSegnalazioneModal</h3>
            <EditForm 
                Model="@segnalazioneModel" 
                OnValidSubmit="InviaSegnalazione"
                Context="segnalazioneContext"
            >
                <DataAnnotationsValidator/>
                <ValidationSummary/>
                    
                <label for="luogo">Luogo</label>
                <InputText id="luogo"@bind-Value="segnalazioneModel.Luogo"/>
                <label for="descrizione">Descrizione</label>
                <InputText id="" @bind-Value="segnalazioneModel.Descrizione"/>

                <label for="tipologia">Indica tipologia</label>
                <InputSelect required id="tipologia" @bind-Value="segnalazioneModel.IdTipologia">
                    <option disabled selected hidden value="0">
                        Scegli tipologia
                    </option>
                    <option value="1">
                        Idraulico 
                    </option>
                    <option value="2">
                        Elettrico
                    </option>
                    <option value="3">
                        Fognario
                    </option>
                    <option value="4">
                        Gas
                    </option>
                    <option value="5">
                        Linee dati
                    </option>
                </InputSelect>

                <div>
                    <button type="submit" 
                        disabled="@(!segnalazioneContext.Validate())"
                        >Invia nuova segnalazione</button>
                    <button @onclick="Chiudi">Chiudi</button>
                </div>
            </EditForm>
            }
            else
            {            
                    <p>Invio in corso</p>            
            }
        </dialog>
    </div>
}
@code {
    [Parameter]
    public EventCallback OnChiudi { get; set; }
    [Parameter]
    public EventCallback OnInvia { get; set; }
    [Parameter]
    public bool Nuova { get; set; }

    private bool elaborazione;
    private int parsedId;
    private string? errorMessage;
    private POSTSegnalazioneDto segnalazioneModel = new();
    

    private async Task InviaSegnalazione()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("api_test1");
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            var sId = user.FindFirst("sid")?.Value;
            var uId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            var uri = $"utenze/{uId}/segnalazioni";
            if (int.TryParse(uId, out parsedId))
            {
                elaborazione = true;
                segnalazioneModel.IdUtenza = parsedId;
                Log.Debug("{@dto}", segnalazioneModel);
                using var response = await AuthedHttp.SendAsync(
                    client, HttpMethod.Post, uri, segnalazioneModel
                );
                response.EnsureSuccessStatusCode();
                StateHasChanged();
                elaborazione = false;
                await Inviata();
                segnalazioneModel = new();
            }                       
        }
        catch (HttpRequestException ex)
        {
            Log.Debug("Caso request {@dto}", segnalazioneModel);
            errorMessage = $"Errore durante l'invio dei dati: {ex.Message}";
        }
        catch (UnauthorizedAccessException)
        {
            Log.Debug("Caso unauthorized {@dto}", segnalazioneModel);
            errorMessage = "Accesso alla risorsa non autorizzato";
        }
        catch (Exception ex)
        {
            errorMessage = "Si è verificato un errore durante il caricamento dei dati.";
            Log.Debug("{message}", ex.Message);
        }

    }
    private async Task Chiudi()
    {
        if (OnChiudi.HasDelegate)
        {
            segnalazioneModel = new();
            await OnChiudi.InvokeAsync();
        }
    }
    private async Task Inviata()
    {
        if (OnInvia.HasDelegate) await OnInvia.InvokeAsync();
    }
}
