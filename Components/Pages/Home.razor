@page "/"
@inject AuthSessionManager AuthSession
@inject UserSessionService UserSession
@implements IDisposable


<h3>Home</h3>
@if (!UserSession.IsAuthenticated)
{
    <Login/>
}
else
{
    <Dashboard/>
}
@code {
    protected override void OnInitialized()
    {        
        UserSession.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        UserSession.OnChange -= StateHasChanged;
    }
}
