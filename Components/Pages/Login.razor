@page "/login"

@inject AuthService Auth
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<h3>Login</h3>

@if (successMessage is null)
{
<EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <label for="email">E-Mail</label>
    <InputText id="email" @bind-Value="loginModel.Email" />
    <ValidationMessage For="@(()=>loginModel.Email)" />

    <label for="password">Password</label>
    <InputText id="password" type="password" @bind-Value="loginModel.Password"/>
    <ValidationMessage For="@(()=>loginModel.Password)"/>

    @if (errorMessage is not null)
    {
        <p role="alert">@errorMessage</p>
    }
    
    <button type="submit">Accedi</button>
</EditForm>
}
<div>
@if (successMessage is not null)
{
    <p role="alert">@successMessage</p>
    <p>@message</p>
    <p>@risposta</p>
}
</div>

@code {
    private LoginDto loginModel = new();

    private string? errorMessage;
    private string? successMessage;
    private string? message;
    private string? risposta;

    private async Task HandleLogin()
    {
        try
        {
            var result = await Auth.HandleLogin(loginModel);
            if (result is not null && result.Success)
            {
                successMessage = "Caricamento dashboard in corso";
                message = result.Message;
                StateHasChanged();
                await Task.Delay(5000);

                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
        catch (JSException ex)
        {
            Log.Debug("Message: {1}",ex.Message);
        }
    }
    private sealed class LoginResult
    {
        public bool Success { get; set; }
        public int Status { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}
