@page "/login"
@using clientside_ticketmanutenzione.Dtos;

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h3>Login</h3>
@* <form>
    <label for="email">E-Mail</label>
    <input type="email" name="email"/>
    <label for="password">Password</label>
    <input type="password" name="password" />

    <button type="submit">Accedi</button>
</form> *@
@if (successMessage is null)
{
<EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

    <label for="email">E-Mail</label>
    <InputText id="email" @bind-Value="loginModel.Email" />
    <ValidationMessage For="@(()=>loginModel.Email)" />

    <label for="password">Password</label>
    <InputText id="password" type="password" @bind-Value="loginModel.Password"/>
    <ValidationMessage For="@(()=>loginModel.Password)"/>

    @if (errorMessage is not null)
    {
        <p role="alert">@errorMessage</p>
    }
    
    <button type="submit">Accedi</button>
</EditForm>
}
<div>
@if (successMessage is not null)
{
    <p role="alert">@successMessage</p>
    <p>@risposta</p>
}
</div>

