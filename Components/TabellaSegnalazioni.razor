<h3>TabellaSegnalazioni</h3>
<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Data Apertura</th>
            <th>Descrizione</th>
            <th>Luogo</th>
            <th>Tipologia</th>
            <th>Lavori in corso</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @{
            int i = 0;
        }
        @if (Segnalazioni is not null)
        {
            @foreach (var segnalazione in Segnalazioni)
            {
                <tr>
                    <td>@i</td>
                    <td>@segnalazione.DataSegnalazione</td>
                    <td>@segnalazione.Descrizione</td>
                    <td>@segnalazione.Luogo</td>
                    <td>@segnalazione.Tipologia</td>
                    <td>@(segnalazione.AzioniAttive?"Lavori in corso":"Nessuna operazione in corso")</td>
                    <td><button @onclick="()=>ApriDettagli(segnalazione.Id)">Dettagli</button></td>
                </tr>
                {i++;}
            }
        }
    </tbody>
</table>

<SegnalazioneModal IdSegnalazione = "@idSegnalazione"  OnChiudi="ChiudiDettagli"/>
@code {
    private int idSegnalazione;
    [Parameter]
    public SegnalazioniOperatoreDto[]? Segnalazioni { get; set; }
    private void ApriDettagli(int id)
    {
        idSegnalazione = id;
    }
    private void ChiudiDettagli()
    {
        idSegnalazione = 0;
    }
}
