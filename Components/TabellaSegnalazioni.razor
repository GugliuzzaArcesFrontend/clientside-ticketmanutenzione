@* <h3>TabellaSegnalazioni</h3> *@
<table class="custom-table mt-1 pt-1 overflow-x-auto">
    <thead>
        <tr>
            <th>#</th>
            <th>Data Apertura</th>
            <th>Descrizione</th>
            <th>Luogo</th>
            <th>Tipologia</th>
            <th>Lavori in corso</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @{
            int i = 1;
        }
        
        @if (Segnalazioni is not null)
        {
            @foreach (var segnalazione in Segnalazioni)
            {
                <tr @onclick="()=>ApriDettagli(segnalazione.Id)">
                    <td>#@i</td>
                    <td>@segnalazione.DataSegnalazione</td>
                    <td>@segnalazione.Descrizione</td>
                    <td>@segnalazione.Luogo</td>
                    <td>@segnalazione.Tipologia</td>
                    
                    <td @onclick:stopPropagation>
                        <CustomButtonSm                             
                            Classes="@(segnalazione.AzioniAttive?"btn-success":"btn-warning")"
                            
                            @onclick="@(e=>
                            {
                                if (segnalazione.AzioniAttive) {VediAzione(segnalazione.IdAzioneAttiva??0);}
                                else {CreaAzione(segnalazione.Id);}
                            })"
                        >
                            @(segnalazione.AzioniAttive ? "Vedi azione" : "Crea nuova")
                        </CustomButtonSm>
                    </td>

                    <td>
                        <CustomButtonSm @onclick="() => ApriDettagli(segnalazione.Id)">Dettagli</CustomButtonSm>
                    </td>
                </tr>
                {i++;}
            }
        }
    </tbody>
</table>

<SegnalazioneModal 
    IdSegnalazione = "@idSegnalazione" 
    SegnalazioneAperta="SegnalazioneAperta" 
    OnChiudiDettagli="ChiudiDettagli"/>

@* <CreaAzioneModal 
    IdSegnalazione="@idSegnalazione" 
    AzioneNuova="AzioneNuova" 
    OnChiudiAzione="ChiudiAzione"/> *@

<VediAzioneModal
    IdSegnalazione="@idSegnalazione"
    IdAzione="@idAzione" 
    AzioneAperta="AzioneAperta" 
    OnChiudiAzione="ChiudiAzione"
    OnDataChange="OnDataChange"
    />

@code {
    [Parameter]
    public SegnalazioniOperatoreDto[]? Segnalazioni { get; set; }

    private int idSegnalazione;
    private int idAzione;

    // public bool AzioneNuova { get; set; }
    public bool AzioneAperta { get; set; }
    public bool SegnalazioneAperta { get; set; }

    [Parameter]
    public EventCallback OnDataChange { get; set; }



    private void CreaAzione(int idSeg)
    {
        idSegnalazione = idSeg;
        // AzioneNuova = true;
        AzioneAperta = true;
    }
    public void VediAzione(int idAz)
    {
        AzioneAperta = true;
        idAzione = idAz;
    }
    private void ChiudiAzione()
    {
        idSegnalazione = 0;
        idAzione = 0;
        // AzioneNuova = false;
        AzioneAperta = false;
        StateHasChanged();
    }
    private void ApriDettagli(int id)
    {
        idSegnalazione = id;
        SegnalazioneAperta = true;
    }
    private void ChiudiDettagli()
    {
        idSegnalazione = 0;
        SegnalazioneAperta = false;
    }
}
