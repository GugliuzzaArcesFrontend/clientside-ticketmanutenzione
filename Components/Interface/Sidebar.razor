        <NavLink href="/">Dashboard</NavLink>
        <NavLink href="/segnalazioni">Segnalazioni</NavLink>
        <NavLink href="/azioni">Azioni</NavLink>
        <NavLink href="/manutentori">Manutentori</NavLink>
        <NavLink href="/profilo">Gestione account</NavLink>
