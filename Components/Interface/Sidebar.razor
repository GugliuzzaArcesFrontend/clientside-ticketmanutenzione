</aside>
@code {
    [Parameter]
    public bool isSidebarOpen { get; set; } = false;

    private List<(string Href, string Text)> anchorsList = [
            ("/","Dashboard"),
            ("/segnalazioni", "Segnalazioni"),
            ("/azioni","Operazioni"),
            ("/manutentori","Lista manutentori"),
            ("/profilo","Pagina personale"),

    ];
    private void HandleThemeChange(ChangeEventArgs args)
    {
        if (Enum.TryParse<ComponentsHandlingService.Theme>(
            args.Value?.ToString(),
            out var theme))
        {
            ComponentsHandling.SetTheme(theme);
        }
    }
}
