@inject IJSRuntime JS
<section @ref="SectionTop" class="scroll-container-y @Classes" style="height:@($"{SectionHeight ?? 100}%")">
    @ChildContent

    @if (isYScrollable)
    {        
        <ButtonScrollToTop ScrollTarget="SectionTop"/>
    }
</section>

@code{
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Classes { get; set; } = string.Empty;
    
    [Parameter]
    public int? SectionHeight { get; set; }

    public ElementReference SectionTop { get; set; }

    private bool isYScrollable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var isScrollable = await JS.InvokeAsync<bool>(
            "isElementYScrollable",
            SectionTop
            );

        if (isYScrollable != isScrollable)
        {
            isYScrollable = isScrollable;
            StateHasChanged();
        }
    }

}